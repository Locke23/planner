# Copy this file to .env and fill in your own values.
# See README.md for instructions on generating JWT keys.

DATABASE_URL=postgresql://<user>:<password>@127.0.0.1:5432/planner
REDIS_URL=redis://127.0.0.1:6379

# Base64-encoded RSA private key (PEM format).
# Generate: openssl genrsa -out jwt-private.pem 2048 && base64 -w 0 jwt-private.pem
JWT_PRIVATE_KEY=<base64-encoded-rsa-private-key>

# Base64-encoded RSA public key (PEM format).
# Generate: openssl rsa -in jwt-private.pem -pubout -out jwt-public.pem && base64 -w 0 jwt-public.pem
JWT_PUBLIC_KEY=<base64-encoded-rsa-public-key>

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

PORT=3000
