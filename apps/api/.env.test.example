# Copy this file to .env.test and fill in your own values.
# These are used when running integration/e2e tests against a local test database.
# Start the test infrastructure with: docker compose -f docker-compose.test.yml up -d

DATABASE_URL=postgresql://planner_test:planner_test@127.0.0.1:5433/planner_test
REDIS_URL=redis://127.0.0.1:6380

JWT_ACCESS_SECRET=<any-random-string-for-tests>
JWT_REFRESH_SECRET=<any-random-string-for-tests>

PORT=3001
