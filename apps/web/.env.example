# Copy this file to .env and adjust values for your environment.

# Base URL for API calls. Defaults to /api/v1 (proxied by Vite dev server).
# Set to a full URL (e.g. https://api.example.com/api/v1) when deploying to a separate origin.
VITE_API_BASE_URL=/api/v1

# Target for Vite's dev-server proxy. All /api/* requests are forwarded here.
# Only used at build/dev time — not exposed to the browser bundle.
API_PROXY_TARGET=http://localhost:3000

# Port for the Vite dev server and preview server. Defaults to 4200.
# VITE_PORT=4200
